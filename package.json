{
  "name": "cour-de-recre",
  "private": true,
  "version": "1.0.0",
  "description": "Jeu de stratégie en temps réel isométrique, remake personnel et non commercial. Interface en français, pensé pour iPhone.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "python3 scripts/make-icons.py"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.13",
    "@types/node": "^26.6.5",
    "jsdom": "^30.1.3",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
